    "com.iatec.nephos": {
      "layer": "theme",
      "expectedCount": 14,
      "origin": "Figma DS-IA-NEPHOS 5.0, colecao theme, leitura de 2026-08-24; brand-50, 100, 200, 300, 800, 900, brand-focus e brand-400-hover lidos em 2026-10-05 (DSA-04)",
      "modeSet": {
        "name": "brand",
        "modes": [
          "sistemas",
          "gerencial",
          "educacao",
          "comercial",
          "financeiro",
          "igrejas",
          "rh"
