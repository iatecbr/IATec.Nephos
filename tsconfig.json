{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["vite/client"],

    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* As stories em .ts leem os dicionarios de idioma, que sao .js do Storybook. */
    "allowJs": true,
    "checkJs": false,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,

    /*
     * Lit sem decorators exige campos de classe compilados para atribuicao no
     * construtor: com a semantica `define`, os campos sobrescreveriam os
     * acessores reativos e o componente pararia de reagir a atributo.
     */
    "useDefineForClassFields": false
  },
  "include": ["src/**/*.ts", "vitest.config.ts"]
}
